# Copy to .env for local development. Never commit .env — this repository is public.

# ---------------------------------------------------------------- Sandesh's own database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sandesh
DB_USER=sandesh
DB_PASSWORD=sandesh_dev_password

# ---------------------------------------------------------------- Nirman, read-only
# The role created by nirman/backend/.../V43__chat_contract_views.sql. It may SELECT from two
# views and nothing else — see docs/PLAN.md §3.
NIRMAN_DB_HOST=localhost
NIRMAN_DB_PORT=5432
NIRMAN_DB_NAME=nirman
NIRMAN_DB_USER=chat_reader
NIRMAN_DB_PASSWORD=chat_reader_dev_password

# ---------------------------------------------------------------- tokens
# MUST be byte-identical to Nirman's JWT_SECRET. Sandesh verifies the tokens Nirman issues; a
# different secret here means every request is refused with no useful error.
JWT_SECRET=change-me-to-the-same-secret-nirman-uses-min-32-bytes
JWT_ISSUER=nirman

# ---------------------------------------------------------------- media
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=sandesh_minio
STORAGE_SECRET_KEY=sandesh_minio_dev_password
STORAGE_BUCKET=sandesh-media

# ---------------------------------------------------------------- browser
CORS_ALLOWED_ORIGINS=http://localhost:5174
VITE_API_BASE_URL=/api/v1
VITE_NIRMAN_API_BASE_URL=http://localhost:8080/api/v1
