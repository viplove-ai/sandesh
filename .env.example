# Copy to .env for local development. Never commit .env — this repository is public.

# Note: DATABASE_URL is taken whole in both profiles — Neon needs sslmode in the string, so
# there is nothing gained by rebuilding it from a host and a port here.

# ---------------------------------------------------------------- the database
# Nirman's database, one connection. Sandesh's own tables live in a `sandesh` schema inside it,
# created by Flyway on first boot; the directory reads two views in `public` on the same
# connection. The role needs CREATE on the database, or the schema cannot be made.
DATABASE_URL=jdbc:postgresql://localhost:5432/nirman
DB_USER=nirman
DB_PASSWORD=nirman_dev_password

# ---------------------------------------------------------------- tokens
# MUST be byte-identical to Nirman's JWT_SECRET. Sandesh verifies the tokens Nirman issues; a
# different secret here means every request is refused with no useful error.
JWT_SECRET=change-me-to-the-same-secret-nirman-uses-min-32-bytes
JWT_ISSUER=nirman

# ---------------------------------------------------------------- media
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=sandesh_minio
STORAGE_SECRET_KEY=sandesh_minio_dev_password
STORAGE_BUCKET=sandesh-media

# ---------------------------------------------------------------- browser
CORS_ALLOWED_ORIGINS=http://localhost:5174
VITE_API_BASE_URL=/api/v1
VITE_NIRMAN_API_BASE_URL=http://localhost:8080/api/v1
